# ============================================
# LLM Wiki 知识库问答 — 模型配置
# ============================================
# 只需配置以下 3 项即可，支持任何 OpenAI 兼容接口
#
# OPENAI_API_KEY  — API 密钥
# BASE_URL        — API 地址
# MODEL           — 模型名称
#
# 常见大厂配置示例见下方 ↓
# ============================================

# --- 基础配置 ---
OPENAI_API_KEY=your-api-key-here
BASE_URL=http://localhost:11434/v1
MODEL=mimo

# --- 服务配置 ---
PORT=3000
MAX_ITERATIONS=10
MAX_TOKENS=4096

# --- 并发控制（可选） ---
RATE_LIMIT_PER_IP=10     # 每 IP 每分钟最多请求数
MAX_CONCURRENCY=5        # 全局最大同时处理的 Agent 任务数
AGENT_TIMEOUT_SEC=120    # 单次任务最长运行时间（秒）
MAX_QUEUE_SIZE=20        # 超出并发上限时，最多排队等待的任务数

# ============================================
# 各大厂配置示例（取消注释对应区块即可）
# ============================================

# --- DeepSeek ---
# OPENAI_API_KEY=sk-xxx
# BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# --- 通义千问 (阿里云 DashScope) ---
# OPENAI_API_KEY=sk-xxx
# BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-plus

# --- 智谱 AI (GLM-4) ---
# OPENAI_API_KEY=xxx.xxx
# BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4

# --- Moonshot (Kimi) ---
# OPENAI_API_KEY=sk-xxx
# BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-8k

# --- 百度千帆 (文心一言) ---
# OPENAI_API_KEY=xxx
# BASE_URL=https://qianfan.baidubce.com/v2
# MODEL=ernie-4.0-8k

# --- 字节豆包 ---
# OPENAI_API_KEY=xxx
# BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL=doubao-pro-256k

# --- 讯飞星火 ---
# OPENAI_API_KEY=xxx
# BASE_URL=https://spark-api-open.xf-yun.com/v1
# MODEL=generalv3.5

# --- 小米 MiMo (本地 Ollama) ---
# OPENAI_API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=mimo

# --- 硅基流动 (SiliconFlow) ---
# OPENAI_API_KEY=sk-xxx
# BASE_URL=https://api.siliconflow.cn/v1
# MODEL=deepseek-ai/DeepSeek-V3
